#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

// This function processes all pairs and prints the maximums
void calculate_the_maximum(int n, int k) {
    int max_and = 0;
    int max_or = 0;
    int max_xor = 0;
    
    // Nested loops to evaluate every valid distinct pair (i, j) where i < j
    for (int i = 1; i <= n; i++) {
        for (int j = i + 1; j <= n; j++) {
            int current_and = i & j;
            int current_or = i | j;
            int current_xor = i ^ j;
            
            // Check if current AND value is less than k and greater than our recorded max
            if (current_and < k && current_and > max_and) {
                max_and = current_and;
            }
            // Check if current OR value is less than k and greater than our recorded max
            if (current_or < k && current_or > max_or) {
                max_or = current_or;
            }
            // Check if current XOR value is less than k and greater than our recorded max
            if (current_xor < k && current_xor > max_xor) {
                max_xor = current_xor;
            }
        }
    }
    
    // Output the results sequentially on new lines as required by the format
    printf("%d\n", max_and);
    printf("%d\n", max_or);
    printf("%d\n", max_xor);
}

int main() {
    int n, k;
  
    // Reads space-separated integers for n and k from standard input
    scanf("%d %d", &n, &k);
    
    // Invokes the computation block
    calculate_the_maximum(n, k);
 
    return 0;
}
